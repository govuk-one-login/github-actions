    "eslint-plugin-json": "^3.1.0",
    "eslint-plugin-prettier": "^5.0.1",
    "eslint-plugin-yml": "^1.12.2",
    "prettier": "^3.2.4",
    "typescript": "^5.3.3",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  }
